      },
      "required": [
        "id",
        "intent",
        "screen",
        "target",
        "value"
      ],
      "title": "FillStep",
      "type": "object"
    },
    "Fingerprint": {
      "additionalProperties": false,
      "description": "What the control looked like when recorded. Not used to act; used to explain drift.",
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "role"
      ],
      "title": "Fingerprint",
      "type": "object"
    },
    "FrameScope": {
      "additionalProperties": false,
      "description": "Where a control lives. For web: a frame, matched by name, then URL path as fallback.",
      "properties": {
        "kind": {
          "const": "frame",
          "default": "frame",
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "url_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url Path"
        }
      },
      "title": "FrameScope",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "money",
            "enum",
            "date"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "classification": {
          "default": "internal",
          "enum": [
            "public",
            "internal",
            "financial",
            "pii",
            "secret"
          ],
          "title": "Classification",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex the raw string form must fully match.",
          "title": "Pattern"
        },
        "values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed values for enum inputs.",
          "title": "Values"
        },
        "source": {
          "default": "caller",
          "enum": [
            "caller",
            "secret"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "type",
        "description"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "LabelLocator": {
      "additionalProperties": false,
      "description": "A control of `role` positioned right of / below the visible text `label`. This is how an\noperator finds a field on a table-layout screen with no <label for>. Geometry-based, so it also\nmaps onto screenshot+OCR surfaces.",
      "properties": {
        "strategy": {
          "const": "label",
          "default": "label",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "role",
        "label"
      ],
      "title": "LabelLocator",
      "type": "object"
    },
    "Literal_": {
      "additionalProperties": false,
