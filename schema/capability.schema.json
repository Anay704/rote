    "RoleLocator": {
      "additionalProperties": false,
      "description": "Accessibility role + accessible name. Most semantic; survives markup/CSS churn and exists on\ndesktop accessibility trees (UIA/AX) too. Useless when the control has no accessible name.",
      "properties": {
        "strategy": {
          "const": "role",
          "default": "role",
          "title": "Strategy",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "RoleLocator",
      "type": "object"
    },
    "Screen": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "identify": {
          "description": "All rules must hold.",
          "items": {
            "discriminator": {
              "mapping": {
                "target_present": "#/$defs/TargetRule",
                "text_present": "#/$defs/TextRule",
                "url_path": "#/$defs/UrlPathRule"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/UrlPathRule"
              },
              {
                "$ref": "#/$defs/TextRule"
              },
              {
                "$ref": "#/$defs/TargetRule"
              }
            ]
          },
          "minItems": 1,
          "title": "Identify",
          "type": "array"
        }
      },
      "required": [
        "description",
        "identify"
      ],
      "title": "Screen",
      "type": "object"
    },
    "SecretRef": {
