{
  "$defs": {
    "AppRef": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "description": "Vendor product id; conditions/auth come from its app profile.",
          "title": "Product",
          "type": "string"
        },
        "compatible_versions": {
          "description": "Version range this flow is known to work on, e.g. '>=4.2,<5'.",
          "title": "Compatible Versions",
          "type": "string"
        },
        "surface": {
          "default": "web",
          "enum": [
            "web",
            "desktop"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "product",
        "compatible_versions"
      ],
      "title": "AppRef",
      "type": "object"
    },
    "ClickStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "description": "What this step is for, in operator language.",
          "title": "Intent",
          "type": "string"
        },
        "screen": {
          "description": "Screen this step acts on; checked before acting.",
          "title": "Screen",
          "type": "string"
        },
        "origin": {
          "default": "model",
          "enum": [
            "model",
            "human",
            "author"
          ],
          "title": "Origin",
          "type": "string"
        },
        "action": {
          "const": "click",
          "default": "click",
          "title": "Action",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "risk": {
          "default": "safe",
          "enum": [
            "safe",
            "reversible",
            "irreversible"
          ],
          "title": "Risk",
          "type": "string"
        },
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expectation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "intent",
        "screen",
        "target"
      ],
      "title": "ClickStep",
      "type": "object"
    },
    "CssLocator": {
