        }
      },
      "required": [
        "secret"
      ],
      "title": "SecretRef",
      "type": "object"
    },
    "SelectStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "description": "What this step is for, in operator language.",
          "title": "Intent",
          "type": "string"
        },
