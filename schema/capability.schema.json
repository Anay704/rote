          "description": "Screen this step acts on; checked before acting.",
          "title": "Screen",
          "type": "string"
        },
        "origin": {
          "default": "model",
          "enum": [
            "model",
            "human",
            "author"
          ],
          "title": "Origin",
          "type": "string"
        },
