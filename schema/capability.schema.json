        "screen": {
          "description": "Screen this step acts on; checked before acting.",
          "title": "Screen",
          "type": "string"
        },
        "origin": {
          "default": "model",
          "enum": [
            "model",
            "human",
            "author"
          ],
          "title": "Origin",
          "type": "string"
        },
        "action": {
          "const": "manual",
          "default": "manual",
          "title": "Action",
          "type": "string"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "risk": {
          "default": "irreversible",
          "enum": [
            "safe",
            "reversible",
            "irreversible"
          ],
          "title": "Risk",
          "type": "string"
